<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="swissup.freeshippingbar.styles"
                   template="Swissup_FreeShippingBar::styles.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Swissup\FreeShippingBar\ViewModel\Styles</argument>
                </arguments>
            </block>
        </referenceBlock>

        <!--
            extraInfo is rendered by Magento_Checkout/minicart/content right under the subtotal,
            which is where the bar belongs. The component itself stays hidden until the
            free-shipping-bar customer data section says otherwise.
        -->
        <referenceBlock name="minicart">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="minicart_content" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="swissup_free_shipping_bar" xsi:type="array">
                                    <item name="component" xsi:type="string">Swissup_FreeShippingBar/js/view/bar</item>
                                    <item name="config" xsi:type="array">
                                        <item name="displayArea" xsi:type="string">extraInfo</item>
                                        <item name="template" xsi:type="string">Swissup_FreeShippingBar/bar</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
