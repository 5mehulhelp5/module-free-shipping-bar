<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <!-- The cart page reloads on every qty change, so this one is rendered server side. -->
            <block class="Magento\Framework\View\Element\Template"
                   name="swissup.freeshippingbar.cart"
                   before="checkout.cart.totals.container"
                   template="Swissup_FreeShippingBar::bar.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Swissup\FreeShippingBar\ViewModel\Bar</argument>
                    <argument name="placement" xsi:type="string">cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
