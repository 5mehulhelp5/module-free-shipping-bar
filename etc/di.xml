<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Swissup\FreeShippingBar\Api\ThresholdResolverInterface"
                type="Swissup\FreeShippingBar\Model\ThresholdResolver"/>

    <!--
        First non-null threshold wins. sortOrder is read by ThresholdResolver itself, because
        di.xml only honours the sortOrder attribute on plugins, not on array items.
    -->
    <type name="Swissup\FreeShippingBar\Model\ThresholdResolver">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="group_override" xsi:type="array">
                    <item name="provider" xsi:type="object">Swissup\FreeShippingBar\Model\Threshold\Provider\GroupOverrideProvider</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
                <item name="carrier_freeshipping" xsi:type="array">
                    <item name="provider" xsi:type="object">Swissup\FreeShippingBar\Model\Threshold\Provider\FreeShippingCarrierProvider</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="carrier_generic" xsi:type="array">
                    <item name="provider" xsi:type="object">Swissup\FreeShippingBar\Model\Threshold\Provider\CarrierFreeShippingProvider</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                </item>
                <item name="sales_rule" xsi:type="array">
                    <item name="provider" xsi:type="object">Swissup\FreeShippingBar\Model\Threshold\Provider\SalesRuleProvider</item>
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
