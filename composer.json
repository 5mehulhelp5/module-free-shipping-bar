{
    "name": "swissup/module-free-shipping-bar",
    "description": "Free shipping progress bar for minicart, cart and checkout",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "OSL-3.0",
    "require": {
        "swissup/module-core": "^1.12",
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": ">=103.0",
        "magento/module-backend": ">=102.0",
        "magento/module-checkout": ">=100.4",
        "magento/module-config": ">=101.2",
        "magento/module-customer": ">=103.0",
        "magento/module-quote": ">=101.2",
        "magento/module-store": ">=101.1",
        "magento/module-tax": ">=100.4",
        "ext-json": "*"
    },
    "suggest": {
        "swissup/module-ajaxpro": "Ajax Cart Pro — the bar refreshes with its ajax add-to-cart",
        "magento/module-offline-shipping": "Enables threshold auto-detection from the Free Shipping carrier",
        "magento/module-sales-rule": "Enables threshold auto-detection from Cart Price Rules"
    },
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Swissup\\FreeShippingBar\\": ""
        }
    },
    "extra": {
        "swissup": {
            "links": {
                "docs"     : "https://docs.swissuplabs.com/m2/extensions/free-shipping-bar/",
                "changelog": "https://docs.swissuplabs.com/m2/extensions/free-shipping-bar/changelog/"
            }
        }
    }
}
